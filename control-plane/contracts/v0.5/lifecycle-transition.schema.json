{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jetro.local/control-plane/contracts/v0.5/lifecycle-transition.schema.json",
  "title": "JETRO Control Plane Lifecycle Transition v0.5",
  "description": "Declared state transition. Missing or impossible transitions are rejected by the lifecycle machine. Recorded states are not GitHub approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_kind",
    "mission_id",
    "task_id",
    "contract_id",
    "contract_hash",
    "machine",
    "from_state",
    "to_state",
    "authority_claim"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5"
    },
    "document_kind": {
      "const": "lifecycle_transition"
    },
    "mission_id": {
      "$ref": "#/$defs/mission_id"
    },
    "task_id": {
      "$ref": "#/$defs/task_id"
    },
    "contract_id": {
      "$ref": "#/$defs/contract_id"
    },
    "contract_hash": {
      "$ref": "#/$defs/contract_hash"
    },
    "machine": {
      "type": "string",
      "enum": ["task", "execution", "review"]
    },
    "from_state": {
      "type": "string",
      "minLength": 1
    },
    "to_state": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "authority_claim": {
      "const": "none"
    }
  },
  "$defs": {
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^MISSION-[0-9]{8}-[0-9]{3}$"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^TASK-[0-9]{8}-[0-9]{3}$"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^CONTRACT-[0-9]{8}-[0-9]{3}$"
    },
    "contract_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
